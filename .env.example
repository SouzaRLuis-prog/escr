# ─────────────────────────────────────────────────────────
# Modelo do arquivo .env — este SIM pode ser commitado no Git.
# Copie para ".env" e preencha com os valores reais.
# ─────────────────────────────────────────────────────────

# Senha do usuário postgres do banco do Chatwoot
POSTGRES_PASSWORD=

# Chave secreta do Rails (gere com: openssl rand -hex 64)
SECRET_KEY_BASE=

# Chave de autenticação da Evolution API
EVOLUTION_API_KEY=

# Token do túnel Cloudflare (Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
